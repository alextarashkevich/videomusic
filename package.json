{
  "name": "videomusic",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "assets": "node scripts/copy-wasm.mjs && node scripts/fetch-model.mjs && node scripts/fetch-samples.mjs",
    "predev": "npm run assets",
    "dev": "vite",
    "prebuild": "npm run assets",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "fetch:model": "node scripts/fetch-model.mjs",
    "fetch:samples": "node scripts/fetch-samples.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "three": "^0.185.1",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@types/three": "^0.185.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
